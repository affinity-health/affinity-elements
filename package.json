{
  "name": "@affinity-health/elements",
  "version": "2.0.0",
  "description": "Secure embedded clinical components for the Affinity platform API.",
  "keywords": [
    "affinity",
    "healthcare",
    "prescribing",
    "typescript"
  ],
  "homepage": "https://docs.joinaffinityai.com/api/platform-elements",
  "bugs": {
    "url": "https://github.com/affinity-health/affinity-elements/issues"
  },
  "license": "MIT",
  "author": "Affinity Health",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/affinity-health/affinity-elements.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test",
    "verify": "bun run check && bun run test && bun run build && bun run package:check",
    "package:check": "node scripts/check-package.mjs",
    "prepublishOnly": "bun run verify"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "7.0.2",
    "vite-plus": "0.2.5",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": ">=18.3 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14"
}
